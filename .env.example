# ---- Avatar Studio: copy to .env ------------------------------------------
# Local dev works with NO keys at all: SQLite, local storage, dev auth, the
# mock voice/avatar engines and ffmpeg. Fill keys in as you connect services.

ENV=dev
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string

# Database: SQLite by default (file under ./data). Postgres in compose/prod.
# DATABASE_URL=postgresql+psycopg://avatar:avatar@localhost:5432/avatar
AUTO_CREATE_TABLES=true

# Auth: dev (X-Dev-User-Email header) or clerk
AUTH_MODE=dev
# Platform admin (sees Settings > Connections and Engine Lab). Comma-separated.
# Empty = the first account ever created on this database.
ADMIN_EMAILS=
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Storage: local or r2
STORAGE_BACKEND=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=avatar-studio

# Voice engines (any that are set appear in the voice library)
VOICE_ENGINE_DEFAULT=auto
# ELEVENLABS_API_KEY=
# SARVAM_API_KEY=

# Avatar engine: mock (ffmpeg, local) or runpod
AVATAR_ENGINE_BACKEND=mock
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# Picked by the Stage 0 panel test: wan_s2v or infinitetalk
DEFAULT_ENGINE_PHOTO=wan_s2v

# Claude (script helper, delivery tags, summaries). Optional.
# ANTHROPIC_API_KEY=
LLM_MODEL_SONNET=claude-sonnet-5-5
LLM_MODEL_HAIKU=claude-haiku-5-5

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
